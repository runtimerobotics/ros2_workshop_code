Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: false
      Marker Scale: 0.15
      Value: false
  Global Options:
    Fixed Frame: world
    Background Color: 30; 34; 48
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point: {X: 0.25, Y: 0.0, Z: 0.3}
      Pitch: 0.45
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
