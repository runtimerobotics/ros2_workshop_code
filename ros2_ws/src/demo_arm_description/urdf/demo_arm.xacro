<?xml version="1.0"?>
<!-- The arm itself: five revolute joints and a two-jaw gripper, RRBot style.

     base_link (pedestal)
       joint1  yaw   (z)  → link1  shoulder housing
       joint2  pitch (y)  → link2  upper arm, 0.30 m
       joint3  pitch (y)  → link3  forearm, 0.25 m
       joint4  pitch (y)  → link4  wrist
       joint5  roll  (z)  → link5  gripper palm
         left_finger_joint  / right_finger_joint  prismatic (y), 0 = closed
       tool0: the grasp point between the finger tips
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="demo_arm" params="parent:=world">

    <link name="base_link">
      <visual>
        <origin xyz="0 0 0.1"/>
        <geometry><box size="0.14 0.14 0.2"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.1"/>
        <geometry><box size="0.14 0.14 0.2"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.1"/>
        <mass value="5.0"/>
        <inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.016"/>
      </inertial>
    </link>
    <joint name="base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="base_link"/>
    </joint>

    <xacro:box_link name="link1" x="0.08" y="0.08" z="0.08" mass="0.6" material="orange"/>
    <xacro:box_link name="link2" x="0.05" y="0.05" z="0.30" mass="0.5" material="black"/>
    <xacro:box_link name="link3" x="0.04" y="0.04" z="0.25" mass="0.35" material="orange"/>
    <xacro:box_link name="link4" x="0.035" y="0.035" z="0.06" mass="0.15" material="black"/>

    <xacro:revolute name="joint1" parent="base_link" child="link1" z="0.2"  axis="0 0 1"
                    lower="${-pi}" upper="${pi}" effort="60" velocity="1.5"/>
    <xacro:revolute name="joint2" parent="link1" child="link2" z="0.08" axis="0 1 0"
                    lower="-1.6" upper="1.6" effort="60" velocity="1.5"/>
    <xacro:revolute name="joint3" parent="link2" child="link3" z="0.30" axis="0 1 0"
                    lower="-2.4" upper="2.4" effort="40" velocity="1.5"/>
    <xacro:revolute name="joint4" parent="link3" child="link4" z="0.25" axis="0 1 0"
                    lower="-2.0" upper="2.0" effort="20" velocity="2.0"/>

    <!-- gripper palm: wide along y, so the fingers slide sideways -->
    <link name="link5">
      <visual>
        <origin xyz="0 0 0.01"/>
        <geometry><box size="0.04 0.11 0.02"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.01"/>
        <geometry><box size="0.04 0.11 0.02"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.01"/>
        <mass value="0.12"/>
        <inertia ixx="1.25e-4" ixy="0" ixz="0" iyy="2.0e-5" iyz="0" izz="1.37e-4"/>
      </inertial>
    </link>
    <xacro:revolute name="joint5" parent="link4" child="link5" z="0.06" axis="0 0 1"
                    lower="${-pi}" upper="${pi}" effort="10" velocity="2.5"/>

    <!-- a finger: its inner face sits at y = 0 of the finger frame and moves out as the joint opens -->
    <xacro:macro name="finger" params="side sign">
      <link name="${side}_finger_link">
        <visual>
          <origin xyz="0 ${sign * 0.006} 0.045"/>
          <geometry><box size="0.025 0.012 0.05"/></geometry>
          <material name="white"/>
        </visual>
        <collision>
          <origin xyz="0 ${sign * 0.006} 0.045"/>
          <geometry><box size="0.025 0.012 0.05"/></geometry>
        </collision>
        <inertial>
          <origin xyz="0 ${sign * 0.006} 0.045"/>
          <mass value="0.03"/>
          <inertia ixx="6.6e-6" ixy="0" ixz="0" iyy="7.8e-6" iyz="0" izz="1.9e-6"/>
        </inertial>
      </link>
      <joint name="${side}_finger_joint" type="prismatic">
        <parent link="link5"/>
        <child link="${side}_finger_link"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 ${sign} 0"/>
        <limit lower="0.0" upper="0.04" effort="40" velocity="0.1"/>
        <dynamics damping="2.0"/>
      </joint>
    </xacro:macro>
    <xacro:finger side="left" sign="1"/>
    <xacro:finger side="right" sign="-1"/>

    <link name="tool0"/>
    <joint name="tool0_joint" type="fixed">
      <parent link="link5"/>
      <child link="tool0"/>
      <origin xyz="0 0 0.055"/>
    </joint>

  </xacro:macro>
</robot>
