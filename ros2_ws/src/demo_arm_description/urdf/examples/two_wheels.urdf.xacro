<?xml version="1.0"?>
<!-- Xacro removes repetition: one macro, two wheels (slide "Xacro removes repetition").

     cd demo_arm_description/urdf/examples
     xacro two_wheels.urdf.xacro > /tmp/robot.urdf
     check_urdf /tmp/robot.urdf          # root Link: base_link has 2 child(ren)
     urdf_to_graphviz /tmp/robot.urdf robot
-->
<robot name="two_wheels" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_link">
    <visual><geometry><box size="0.3 0.2 0.08"/></geometry></visual>
  </link>

  <xacro:macro name="wheel" params="name y">
  <link name="${name}">
    <visual>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </visual>
  </link>
  <joint name="${name}_joint" type="continuous">
    <origin xyz="0 ${y} 0"/>
    <parent link="base_link"/>
    <child link="${name}"/>
    <axis xyz="0 1 0"/>
  </joint>
</xacro:macro>

  <xacro:wheel name="left_wheel" y="0.1"/>
  <xacro:wheel name="right_wheel" y="-0.1"/>
</robot>
