Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RealSense points
      Topic:
        Value: /camera/camera/depth/color/points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Value: true
    - Class: rviz_default_plugins/Image
      Name: RealSense colour
      Topic:
        Value: /camera/camera/color/image_raw
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Topic:
        Value: /scan
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 255; 80; 160
      Value: true
    - Class: rviz_default_plugins/Wrench
      Name: Wrist force-torque
      Topic:
        Value: /wrist_ft
      Force Arrow Scale: 0.1
      Torque Arrow Scale: 1.0
      Arrow Width: 0.1
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 30; 34; 48
  Name: root
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point: {X: 0.3, Y: 0.0, Z: 0.3}
      Pitch: 0.5
      Yaw: 0.9
Window Geometry:
  Height: 900
  Width: 1400
