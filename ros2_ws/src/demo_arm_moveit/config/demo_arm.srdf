<?xml version="1.0"?>
<!-- Semantic description for MoveIt: planning groups, named poses, the end effector,
     and link pairs that can never collide (so collision checking skips them). -->
<robot name="demo_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <link name="left_finger_link"/>
    <link name="right_finger_link"/>
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-0.4"/>
    <joint name="joint3" value="1.9"/>
    <joint name="joint4" value="1.0"/>
    <joint name="joint5" value="0.0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.3"/>
    <joint name="joint3" value="1.2"/>
    <joint name="joint4" value="1.6"/>
    <joint name="joint5" value="0.0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.04"/>
    <joint name="right_finger_joint" value="0.04"/>
  </group_state>
  <group_state name="close" group="gripper">
    <joint name="left_finger_joint" value="0.0"/>
    <joint name="right_finger_joint" value="0.0"/>
  </group_state>

  <end_effector name="hand" parent_link="link5" group="gripper" parent_group="arm"/>

  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="left_finger_link" reason="Never"/>
  <disable_collisions link1="link4" link2="right_finger_link" reason="Never"/>
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="camera_stand" reason="Never"/>
  <disable_collisions link1="base_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="camera_stand" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link2" reason="Never"/>
  <disable_collisions link1="link1" link2="camera_stand" reason="Never"/>
</robot>
