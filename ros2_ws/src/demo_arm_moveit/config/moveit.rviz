Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 20
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Move Group Namespace: ""
      Planning Request:
        Planning Group: arm
        Interactive Marker Size: 0.15
        Query Goal State: true
        Query Start State: false
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trajectory Topic: /display_planned_path
      Scene Geometry:
        Scene Alpha: 0.8
        Show Scene Geometry: true
        Voxel Rendering: Occupied Voxels
        Voxel Coloring: Z-Axis
        Octomap Render: Occupied Voxels
      Value: true
    - Class: rviz_default_plugins/Image
      Name: RealSense colour
      Topic:
        Value: /camera/camera/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Detections
      Topic:
        Value: /detections/image
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected objects
      Topic:
        Value: /detections/markers
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 30; 34; 48
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point: {X: 0.3, Y: 0.0, Z: 0.25}
      Pitch: 0.55
      Yaw: 0.9
Window Geometry:
  Height: 950
  Width: 1500
