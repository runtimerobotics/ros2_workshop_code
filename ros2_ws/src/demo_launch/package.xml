<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_launch</name>
  <version>1.0.0</version>
  <description>Launch files in Python, XML, and YAML: arguments, namespaces, parameters, includes, events</description>
  <maintainer email="maintainer@example.com">RUNTIME Robotics</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch_yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>demo_turtlesim</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
